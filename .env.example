LEETCODE_USERNAME=your_username
TZ=America/Toronto
DATABASE_URL=sqlite:///./data/tracker.db
DAILY_GOAL=1

# Background jobs (v2): auto-sync and an evening reminder
ENABLE_SCHEDULER=false
SYNC_INTERVAL_HOURS=3
REMINDER_TIME=20:00

# Phone notifications via ntfy (leave NTFY_TOPIC empty to turn them off)
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=

# Other browser apps allowed to call the API directly, comma-separated.
# Add your dashboard's origin here, e.g. http://localhost:5174,http://localhost:5173
CORS_ORIGINS=http://localhost:5174
